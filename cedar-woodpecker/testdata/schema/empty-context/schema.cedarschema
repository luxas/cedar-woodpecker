entity User { name: String };
entity Pod { namespace: String };
entity Secret { namespace: String };
type Ctx = { tenant: String };
action create appliesTo { principal: User, resource: [Pod, Secret] };
action get appliesTo { principal: User, resource: [Pod, Secret], context: Ctx };
action patch appliesTo { principal: User, resource: [Pod, Secret], context: { dry: Bool } };
